+    def _find_free_pool_blocks(self) -> list[tuple[int, AllocationData]]:
+        """
+        Find allocations in ``pointer_to_data`` whose blocks the torch NPU
+        caching allocator currently keeps as cached (freed) blocks.
+
+        Freed pool blocks go to the MemPool free lists instead of ``my_free``,
+        so ``python_free_callback`` never runs and the handles stay in
+        ``pointer_to_data``. Only ``sleep()`` can return their physical HBM:
+        unmap + free the physical memory now and re-map the same handles in
+        ``wake_up()``.
+
+        torch_npu 2.9.0 exposes no working ``emptyCache``/``releasePool`` for
+        the pluggable allocator (both are no-ops), so the block inventory is
+        read from ``torch.npu.memory_snapshot()``: segments owned by our
+        MemPools carry a ``segment_pool_id``, and a free (cached) block has
+        ``state == "inactive"`` (i.e. contributes 0 to ``allocated_size``).
+        """
+        try:
+            snapshot = torch.npu.memory_snapshot()
+        except Exception as e:  # pragma: no cover - NPU only
+            logger.warning("[camem] memory_snapshot unavailable: %s", e)
+            return []
+
+        pool_ids = set()
+        for mem_pool, _alloc in self.allocator_and_pools.values():
+            try:
+                pool_ids.add(tuple(mem_pool.id))
+            except Exception:  # pragma: no cover - defensive
+                continue
+
+        free_blocks: list[tuple[int, AllocationData]] = []
+        for segment in snapshot:
+            owner = segment.get("segment_pool_id", segment.get("owner_private_pool_id"))
+            if owner is None or tuple(owner) not in pool_ids:
+                continue
+            for block in segment.get("blocks", []):
+                # Only whole, non-split blocks can match a handle we own:
+                # pointer_to_data is keyed by the reserved base address.
+                if block.get("state") == "inactive":
+                    data = self.pointer_to_data.get(block.get("address"))
+                    if data is not None:
+                        free_blocks.append((block.get("address"), data))
+        return free_blocks
+
+    def _unmap_free_pool_blocks(self, free_blocks: list[tuple[int, AllocationData]]) -> int:
+        """
+        Unmap and release physical HBM of cached free pool blocks.
+
+        The address reservations and handles are kept in ``pointer_to_data``,
+        so ``wake_up()`` can re-map them before the engine resumes.
+        """
+        unmapped_bytes = 0
+        for ptr, data in free_blocks:
+            handle = data.handle
+            try:
+                unmap_and_release(handle)
+                unmapped_bytes += handle[1]
+            except Exception as e:  # pragma: no cover - NPU only
+                logger.warning("[camem] failed to unmap free block ptr=%s: %s", ptr, e)
+        if unmapped_bytes > 0:
+            logger.info(
+                "[camem] sleep: unmapped %d cached free pool block(s), %.2f GiB returned",
+                len(free_blocks),
+                unmapped_bytes / 1024**3,
+            )
+        return unmapped_bytes
+
